{
  "env": {
    "INDY_NETWORK": "INDYSCANPOOL",
    "ES_URL": "http://elasticsearch:9200",
    "ES_INDEX": "txs-indyscanpool",
    "WORKER_TIMING": "SLOW"
  },
  "workersBuildersTemplate": [
    {
      "builder": "rtwSerialization",
      "params": {
        "indyNetworkId": "{{{INDY_NETWORK}}}",
        "genesisPath": "{{{GENESIS_URL}}}",
        "esIndex": "{{{ES_INDEX}}}",
        "esUrl": "{{{ES_URL}}}",
        "workerTiming": "{{{WORKER_TIMING}}}"
      }
    },
    {
      "builder": "rtwExpansion",
      "params": {
        "indyNetworkId": "{{{INDY_NETWORK}}}",
        "esUrl": "{{{ES_URL}}}",
        "esIndex": "{{{ES_INDEX}}}",
        "workerTiming": "{{{WORKER_TIMING}}}"
      }
    }
  ]
}
